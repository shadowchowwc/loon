#!name = 百度网页去广告 by Shadow
#!desc = 移除百度搜索移动端网页的首页广告信息流
#!date = 2026-11-01
#!homepage = https://github.com/shadowchowwc
#!author = Keywos[https://github.com/Keywos], Shadow[https://github.com/shadowchowwc]
#!openUrl = https://www.baidu.com
#!icon = https://raw.githubusercontent.com/shadowchowwc/loon/refs/heads/main/icon/baidu.jpg

[Script]
response if ${url} ~= /^https?:\/\/(www|m)\.baidu\.com\/?($|\?from=\w{8,9})/i then script("https://raw.githubusercontent.com/shadowchowwc/loon/refs/heads/main/script/baidu-homepage.js") with tag="移除百度搜索首页信息流广告", requires_body=true

[MitM]
hostname=m.baidu.com, www.baidu.com
