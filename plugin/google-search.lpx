#!name = Google 搜索首页 by Shadow
#!desc = 简洁版 Google 搜索首页
#!date = 2026-11-02
#!homepage = https://github.com/shadowchowwc
#!author = Shadow[https://github.com/shadowchowwc]
#!openUrl = https://www.google.com
#!icon = https://raw.githubusercontent.com/shadowchowwc/loon/refs/heads/main/icon/google.jpg

[Script]
response if ${url} ~= /^https:\/\/www\.google\.com\/(?:\?.*)?$/i && ${response.status} == 200 then script("https://raw.githubusercontent.com/shadowchowwc/loon/refs/heads/main/script/google-search.js") with tag="Google 首页替换"

[MITM]
hostname = www.google.com
