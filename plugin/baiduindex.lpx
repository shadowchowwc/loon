#!name=百度网页去广告
#!desc=移除百度搜索移动端网页的首页广告信息流
#!openUrl=https://www.baidu.com
#!author=Keywos[https://github.com/Keywos]
#!tag=Ad
#!homepage=https://github.com/shadowchowwc/loon
#!icon=https://raw.githubusercontent.com/shadowchowwc/loon/refs/heads/main/icon/baidu.jpg
#!date=2026-11-01 20:58:55

[Script]


response if ${url} ~= /^https?:\/\/(www|m)\.baidu\.com\/?($|\?from=\w{8,9})/i then script("https://raw.githubusercontent.com/shadowchowwc/loon/refs/heads/main/script/BaiduSearchHomePage_remove_ads.js") with tag="移除百度搜索首页信息流广告", requires_body=true

[MitM]
hostname=m.baidu.com, www.baidu.com
